{
    "name": "nwidart/laravel-metrics",
    "description": "OpenTelemetry metrics for Laravel that work under PHP-FPM, with zero-code HTTP, database, queue and cache instrumentation.",
    "keywords": [
        "laravel",
        "opentelemetry",
        "metrics",
        "php-fpm",
        "prometheus",
        "otlp"
    ],
    "homepage": "https://github.com/nWidart/laravel-metrics",
    "support": {
        "issues": "https://github.com/nWidart/laravel-metrics/issues",
        "source": "https://github.com/nWidart/laravel-metrics"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Nicolas Widart",
            "email": "n.widart@gmail.com",
            "homepage": "https://nwidart.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "nwidart/metrics-store": "^1.0",
        "open-telemetry/exporter-otlp": "^1.6",
        "open-telemetry/sdk": "^1.17"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "php-http/guzzle7-adapter": "^1.1",
        "predis/predis": "^2.3|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Nwidart\\Metrics\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nwidart\\Metrics\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nwidart\\Metrics\\MetricsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
