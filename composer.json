{
    "name": "nwidart/laravel-metrics",
    "description": "OpenTelemetry metrics for Laravel that work under PHP-FPM, with zero-code HTTP, database, queue and cache instrumentation.",
    "keywords": [
        "laravel",
        "opentelemetry",
        "metrics",
        "php-fpm",
        "prometheus",
        "otlp"
    ],
    "homepage": "https://github.com/nwidart/observability",
    "license": "MIT",
    "authors": [
        {
            "name": "Nicolas Widart",
            "email": "n.widart@gmail.com",
            "homepage": "https://nwidart.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "nwidart/metrics-store": "self.version",
        "open-telemetry/exporter-otlp": "^1.6",
        "open-telemetry/sdk": "^1.17"
    },
    "autoload": {
        "psr-4": {
            "Nwidart\\Metrics\\": "src"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nwidart\\Metrics\\MetricsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
